# PostHog Cloud instance hosts (US: https://us.posthog.com / https://us.i.posthog.com, EU: https://eu.posthog.com / https://eu.i.posthog.com)
POSTHOG_API_HOST=https://eu.posthog.com
POSTHOG_INGEST_HOST=https://eu.i.posthog.com

# PostHog Project ID and Project API Token (public ingest key, phc_...)
POSTHOG_PROJECT_ID=
POSTHOG_PROJECT_TOKEN=phc_your_project_token_here

# PostHog Personal API Key (server-side read key for HogQL queries, phx_... — keep secret, never expose to client)
POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key_here

# Optional: UUID of the enablement-helpful survey. PostHog links `survey sent` events to a survey by UUID.
# If unset, the server looks it up by name using the personal API key.
POSTHOG_SURVEY_ID=
